#!/usr/bin/env bash
set -euo pipefail

# Build into .next-deploy so this never clobbers the supervised dev server's .next.
# NEXT_BUILD_STANDALONE opts into the server bundle the Make nextjs adapter needs.
NODE_ENV=production \
  NEXT_DIST_DIR=.next-deploy \
  NEXT_BUILD_STANDALONE=1 \
  npm run build

[[ -d ".next-deploy" ]] || {
  echo "Expected build output at .next-deploy" >&2
  exit 1
}

figma make deploy --build-dir ".next-deploy" --adapter nextjs
